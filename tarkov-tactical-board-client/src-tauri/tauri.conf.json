{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tarkov Tactical Board",
  "version": "2.0.2",
  "identifier": "site.tarkov.tacticalboard.desktop.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run tauri:build:web",
    "devUrl": "http://127.0.0.1:3000/eftboard/",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tarkov Tactical Board",
        "width": 1440,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
